{
  "name": "panel-frame-ui",
  "version": "0.2.1",
  "description": "Reusable dashboard and account UI components for React applications",
  "license": "MIT",
  "engines": {
    "node": ">=22.14.0"
  },
  "packageManager": "pnpm@12.16.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zakaihamilton/panel-frame-ui.git"
  },
  "homepage": "https://github.com/zakaihamilton/panel-frame-ui#readme",
  "bugs": {
    "url": "https://github.com/zakaihamilton/panel-frame-ui/issues"
  },
  "type": "module",
  "sideEffects": [
    "./styles.css",
    "./styles/*.css"
  ],
  "files": [
    "dist",
    "styles.css",
    "styles",
    "styles.css.d.ts",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": {
      "types": "./styles.css.d.ts",
      "default": "./styles.css"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "prepack": "pnpm run build",
    "health": "pnpm run build && pnpm run lint && pnpm run format:check && pnpm run test && repnix check",
    "health:dead-code": "knip",
    "health:duplication": "jscpd src",
    "health:package:publint": "publint",
    "health:package:types": "attw --pack ."
  },
  "peerDependencies": {
    "react": ">=19.0.0 <20.0.0",
    "react-dom": ">=19.0.0 <20.0.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^9.39.5",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jscpd": "^5.4.3",
    "jsdom": "^31.0.0",
    "knip": "^6.44.2",
    "prettier": "^3.9.10",
    "publint": "^0.3.25",
    "repnix": "^1.1.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
